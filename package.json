{
  "name": "rangebook",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "mcp:build": "vite build -c mcp-app/vite.config.ts --logLevel warn",
    "mcp": "vite build -c mcp-app/vite.config.ts --logLevel error 1>&2 && tsx --tsconfig tsconfig.json src/mcp/server.ts",
    "demo:export": "tsx --tsconfig tsconfig.json scripts/demo-export.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:live": "vitest run --project live"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai": "^1.0.0",
    "@tanstack/ai-openrouter": "^1.0.0",
    "@tanstack/ai-react": "^1.0.0",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/query-db-collection": "1.4.8",
    "@tanstack/react-db": "0.5.12",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/store": "0.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.3.6",
    "zod": "^4.3.6"
